<?xml version="1.0" encoding="UTF-8"?>
<!--
  Windows 7 Task Scheduler definition for the iroh serve node:
  starts at boot and at user logon, runs as the given user with an S4U logon
  ("run whether the user is logged on or not", no stored password), restarts
  on failure up to 999 times every minute, no execution time limit.

  Replace MACHINE\user, the pythonw.exe path and the node directory below.
  Windows 7's schtasks only accepts task XML saved as UTF-16 LE with a
  matching encoding declaration, so convert this file first (PowerShell,
  verified on Win7 SP1):

      (Get-Content win7-task.xml -Encoding UTF8) -replace 'UTF-8','UTF-16' |
          Out-File win7-task.u16.xml -Encoding Unicode

  Then import from an ELEVATED prompt:

      schtasks /Create /TN "iroh-ssh serve" /XML win7-task.u16.xml /F

  Then start and verify:

      schtasks /Run /TN "iroh-ssh serve"
      type C:\Users\user\iroh7\serve.log     <- "endpoint id:" must match
                                                the secret.key in
                                                ~\.config\iroh-ssh
-->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>iroh serve node: accepts iroh streams via the relay and forwards each into 127.0.0.1:22 (local sshd). Requires the iroh-win7 wheel deployed under the node directory.</Description>
  </RegistrationInfo>
  <Triggers>
    <BootTrigger>
      <Enabled>true</Enabled>
    </BootTrigger>
    <LogonTrigger>
      <Enabled>true</Enabled>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>MACHINE\user</UserId>
      <LogonType>S4U</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>7</Priority>
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>999</Count>
    </RestartOnFailure>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>C:\Python313\pythonw.exe</Command>
      <Arguments>"C:\Users\user\iroh7\serve_launcher.py"</Arguments>
      <WorkingDirectory>C:\Users\user\iroh7</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
